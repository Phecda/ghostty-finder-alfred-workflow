				<key>applescript</key>
				<string>on alfred_script(q)
  tell application "Ghostty"
    set dirPath to working directory of focused terminal of selected tab of front window
  end tell

  if dirPath is not "" then
    do shell script "open -a Finder " &amp; quoted form of dirPath
  end if
end alfred_script</string>
